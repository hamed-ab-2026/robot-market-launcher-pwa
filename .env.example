# EN: Copy this file to ".env" and adjust values for your environment.
# FA: این فایل را به ".env" کپی کرده و مقادیر را متناسب با محیط خود تغییر دهید.

# When true, axiosConfig.js attaches the mock adapter instead of hitting
# a real device/API. Perfect for UI development without hardware on hand.
VITE_DEV_MODE=true

# Base URL used when a device is reached through "Online Panel" (by URL)
VITE_API_BASE_URL=https://api.example-robot.local

# Timeout (ms) for all outgoing requests
VITE_API_TIMEOUT=10000

# Public endpoint used to verify real internet access, not only Wi-Fi/LAN.
VITE_CONNECTIVITY_CHECK_URL=https://www.gstatic.com/generate_204

# Direct video URL, or place tutorial.mp4 in public/videos/.
VITE_TUTORIAL_VIDEO_URL=/videos/tutorial.mp4
